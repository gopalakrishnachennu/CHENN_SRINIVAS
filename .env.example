OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-5.6

# Gate 3 — optional legacy JSONL dual-write (default off; SQLite is SoT)
# LEARNING_DUAL_WRITE_JSONL=1

# Gate 4 — operator UI auth (optional; when set, login is required)
# RESUME_ENGINE_UI_USER=operator
# RESUME_ENGINE_UI_PASSWORD=change-me
# RESUME_ENGINE_UI_SECRET=optional-stable-flask-secret

# Gate 4 — live Phase 1 harness (explicit paid opt-in)
# RUN_LIVE_TESTS=1
# SKIP_LAYA_LIVE=1
